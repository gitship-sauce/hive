# Copy this file to .env. The database values match docker-compose.yml.
DATABASE_URL=postgres://social:social@localhost:5432/social
TEST_DATABASE_URL=postgres://social:social@localhost:5432/social_test

# Optional: Firebase push notifications (see README, "Turn on push").
# From Firebase console > Project settings > General > Your apps > Web app:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# From Project settings > Cloud Messaging > Web Push certificates (the public key):
FIREBASE_VAPID_KEY=
# From Project settings > Service accounts > Generate new private key. Save it in ./secrets/.
# FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json
